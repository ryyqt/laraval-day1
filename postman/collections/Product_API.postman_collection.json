{
	"info": {
		"_postman_id": "product-api-collection",
		"name": "Day 8 – Product REST API",
		"description": "Complete CRUD API for Products in the Laravel application.\n\nBase URL: http://localhost:8000/api\n\nEndpoints:\n- GET    /api/products          — List all products (paginated)\n- POST   /api/products          — Create a product\n- GET    /api/products/{id}     — Show a single product\n- PUT    /api/products/{id}     — Update a product\n- DELETE /api/products/{id}     — Delete a product",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "product_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "GET All Products",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/products?search=&category_id=&sort=latest&per_page=10",
					"host": ["{{base_url}}"],
					"path": ["products"],
					"query": [
						{
							"key": "search",
							"value": "",
							"description": "Search by product name"
						},
						{
							"key": "category_id",
							"value": "",
							"description": "Filter by category ID"
						},
						{
							"key": "sort",
							"value": "latest",
							"description": "Sort order: latest or oldest"
						},
						{
							"key": "per_page",
							"value": "10",
							"description": "Items per page"
						}
					]
				},
				"description": "Retrieve a paginated list of all products. Supports search, category filter, and sorting."
			},
			"response": []
		},
		{
			"name": "GET Single Product",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/products/{{product_id}}",
					"host": ["{{base_url}}"],
					"path": ["products", "{{product_id}}"]
				},
				"description": "Retrieve a single product by its ID. Returns the product with its category."
			},
			"response": []
		},
		{
			"name": "POST Create Product",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "name",
							"value": "Sample Product",
							"description": "Product name (required)",
							"type": "text"
						},
						{
							"key": "price",
							"value": "29.99",
							"description": "Product price (required, min: 0)",
							"type": "text"
						},
						{
							"key": "quantity",
							"value": "100",
							"description": "Stock quantity (required, min: 0)",
							"type": "text"
						},
						{
							"key": "category_id",
							"value": "1",
							"description": "Category ID (optional)",
							"type": "text"
						},
						{
							"key": "description",
							"value": "A great product for testing the API.",
							"description": "Product description (optional, max 1000 chars)",
							"type": "text"
						},
						{
							"key": "image",
							"description": "Product image (optional, jpg/png/webp/gif, max 2MB)",
							"type": "file",
							"src": ""
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/products",
					"host": ["{{base_url}}"],
					"path": ["products"]
				},
				"description": "Create a new product. Uses form-data to support image uploads."
			},
			"response": []
		},
		{
			"name": "PUT Update Product",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "_method",
							"value": "PUT",
							"description": "Method spoofing for PUT (required for form-data)",
							"type": "text"
						},
						{
							"key": "name",
							"value": "Updated Product Name",
							"description": "Product name",
							"type": "text"
						},
						{
							"key": "price",
							"value": "39.99",
							"description": "Product price",
							"type": "text"
						},
						{
							"key": "quantity",
							"value": "50",
							"description": "Stock quantity",
							"type": "text"
						},
						{
							"key": "category_id",
							"value": "1",
							"description": "Category ID (optional)",
							"type": "text"
						},
						{
							"key": "description",
							"value": "Updated description for the product.",
							"description": "Product description",
							"type": "text"
						},
						{
							"key": "image",
							"description": "New product image (optional)",
							"type": "file",
							"src": ""
						},
						{
							"key": "remove_image",
							"value": "false",
							"description": "Set to true to remove the current image",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/products/{{product_id}}",
					"host": ["{{base_url}}"],
					"path": ["products", "{{product_id}}"]
				},
				"description": "Update an existing product. Uses POST with _method=PUT for form-data compatibility (file uploads)."
			},
			"response": []
		},
		{
			"name": "DELETE Product",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/products/{{product_id}}",
					"host": ["{{base_url}}"],
					"path": ["products", "{{product_id}}"]
				},
				"description": "Delete a product by its ID. Also removes the product's image from storage."
			},
			"response": []
		}
	]
}
